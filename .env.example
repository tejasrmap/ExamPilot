# ExamPilot 2.0 Environment Configuration
# GT InnoX LLP

# Environment: development | production
ENVIRONMENT=development

# Server-side AES-256-GCM Master Encryption Secret (must be minimum 32 chars)
API_KEY_ENCRYPTION_SECRET=exampilot_super_secret_encryption_key_32_bytes_len!!

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=sqlite:///./exampilot_saas.db
# For production Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & JWT
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
JWT_SECRET=exampilot_jwt_secret_token_dev_environment_GT_InnoX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Next.js Frontend Public Configuration (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

